# Environment for the n8n workflows. Copy to n8n.env (git-ignored) and fill in.

# Where n8n reaches the Local Legal AI API. From Docker on macOS/Windows use
# host.docker.internal; on Linux, run the API with HOST=0.0.0.0 and restrict it
# with ALLOWED_IPS (include 127.0.0.1 and the Docker bridge address).
LEGAL_AI_URL=http://host.docker.internal:8000

# Service account created on the 👥 Users page with "Require a new password at
# first sign-in" unchecked. Drop-zone ingestion needs any role; the daily
# digest reads analytics and the audit summary, which require the admin role.
LEGAL_AI_USERNAME=n8n-service
LEGAL_AI_PASSWORD=change-me

# Must equal WEBHOOK_SECRET in the Local Legal AI .env; unsigned or forged
# events are dropped by the alerts workflow.
LEGAL_AI_WEBHOOK_SECRET=change-me

# Category assigned to files picked up from the drop zone.
LEGAL_AI_DROPZONE_CATEGORY=general

# Slack incoming webhook used by the alerts and digest workflows.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
