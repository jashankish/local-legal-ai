# Copy to .env (start_system.sh does this automatically and generates SECRET_KEY).
# Every value must be valid shell syntax: start_system.sh sources this file.

# Application Settings
DEBUG=false
SECRET_KEY=your-secret-key-here-change-this-in-production

# Server Settings — 127.0.0.1 keeps the API reachable only from this machine
HOST=127.0.0.1
PORT=8000

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Sign-in throttling: after this many failures for a username from one address
# within the window, further attempts get HTTP 429 until the window passes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# ChromaDB Settings (embedded, persisted under data/chroma_db)
CHROMADB_COLLECTION=legal_documents

# Local LLM — any OpenAI-compatible server. Without a running model the
# assistant answers in extractive mode with cited source passages.
#   vLLM (GPU):  bash model/vllm_launcher.sh -> MODEL_ENDPOINT=http://localhost:8001  MODEL_NAME=legal-ai-model
#   Ollama:      ollama pull llama3.1:8b     -> MODEL_ENDPOINT=http://localhost:11434 MODEL_NAME=llama3.1:8b
LLM_ENABLED=true
MODEL_ENDPOINT=http://localhost:8001
MODEL_NAME=legal-ai-model
LLM_TIMEOUT_SECONDS=120
MAX_TOKENS=2048
TEMPERATURE=0.1

# Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Document Processing
MAX_FILE_SIZE_MB=50
# Chunk size and overlap in words (~220 fits the embedding model window)
CHUNK_SIZE=220
CHUNK_OVERLAP=40

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security & Audit
ENABLE_AUDIT_LOGGING=true
# Comma-separated client IPs or CIDR ranges allowed to reach the API
# (empty = no restriction). Keep 127.0.0.1 in the list: the UI calls the API locally.
ALLOWED_IPS=
# Browser origins allowed by CORS (the local Streamlit UI)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Watched-folder ingestion: files dropped in INBOX_DIR (or INBOX_DIR/<category>/)
# are indexed automatically, then moved to processed/ or failed/.
INBOX_ENABLED=true
INBOX_DIR=data/inbox
INBOX_POLL_SECONDS=10

# Event notifications (optional). Only metadata is sent, never document text.
# n8n: point at the alerts workflow webhook (see workflows/n8n/README.md)
N8N_WEBHOOK_URL=
# Signs n8n payloads (X-LegalAI-Signature: sha256=<hmac>); use the same value in n8n
WEBHOOK_SECRET=
# Slack incoming webhook for direct alerts without n8n
SLACK_WEBHOOK_URL=
# Comma-separated subset of events to send (empty = all), e.g.
# document.indexed,document.ingest_failed,security.login_failed
NOTIFY_EVENTS=
