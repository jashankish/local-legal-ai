# Copy to .env (start_system.sh does this automatically and generates SECRET_KEY).
# Every value must be valid shell syntax: start_system.sh sources this file.

# Application Settings
DEBUG=false
SECRET_KEY=your-secret-key-here-change-this-in-production

# Server Settings — 127.0.0.1 keeps the API reachable only from this machine
HOST=127.0.0.1
PORT=8000

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ChromaDB Settings (embedded, persisted under data/chroma_db)
CHROMADB_COLLECTION=legal_documents

# Local LLM — any OpenAI-compatible server. Without a running model the
# assistant answers in extractive mode with cited source passages.
#   vLLM (GPU):  bash model/vllm_launcher.sh -> MODEL_ENDPOINT=http://localhost:8001  MODEL_NAME=legal-ai-model
#   Ollama:      ollama pull llama3.1:8b     -> MODEL_ENDPOINT=http://localhost:11434 MODEL_NAME=llama3.1:8b
LLM_ENABLED=true
MODEL_ENDPOINT=http://localhost:8001
MODEL_NAME=legal-ai-model
LLM_TIMEOUT_SECONDS=120
MAX_TOKENS=2048
TEMPERATURE=0.1

# Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Document Processing
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security & Audit
ENABLE_AUDIT_LOGGING=true
# Comma-separated client IPs or CIDR ranges allowed to reach the API
# (empty = no restriction). Keep 127.0.0.1 in the list: the UI calls the API locally.
ALLOWED_IPS=
# Browser origins allowed by CORS (the local Streamlit UI)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# n8n Integration (optional)
N8N_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
